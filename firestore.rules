rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check user id match
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connectivity test path for health checks
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Product Inventory: readable by all clients for store display; modifications restricted to authenticated staff
    match /product_inventory/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Store Configuration (Hero slides, rate list graphic, tickers)
    match /store_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Merchant Support Requests & Complaints
    match /complaints/{complaintId} {
      allow create: if request.resource.data.merchantName is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Placed Orders & Contract Batches
    match /placed_orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.buyer is string;
      allow update, delete: if isAuthenticated();
    }

    // Procurement Requests (Indent Demands)
    match /procurement_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.buyer is string;
      allow update, delete: if isAuthenticated();
    }

    // Warehouse Pending Loadings & Mill Dispatches
    match /pending_loadings/{loadingId} {
      allow read, write: if isAuthenticated();
    }

    // Commodity Arrival Entries
    match /arrival_entries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // Financial Ledgers & Commission Records (Protected)
    match /ledgers/{ledgerId} {
      allow read, write: if isAuthenticated();
    }

    // Patti Settlement Vouchers (Protected)
    match /patti/{pattiId} {
      allow read, write: if isAuthenticated();
    }

    // Mandi Stakeholders & Merchant Directories
    match /stakeholders/{userId} {
      allow read: if true;
      allow create: if request.resource.data.name is string;
      allow update: if isAuthenticated() || isOwner(userId);
      allow delete: if isAuthenticated();
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


